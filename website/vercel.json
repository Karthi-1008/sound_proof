{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "routes": [
    { "src": "/api/candidates", "dest": "/static/candidates.json" },
    { "src": "/api/status", "dest": "/static/status.json" },
    { "src": "/api/audio/(.*)", "dest": "/static/audio/$1" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/", "dest": "/static/index.html" },
    { "src": "/(.*)", "dest": "/static/$1" }
  ]
}
